# ===============================================================================
# SISTEMA BELLIA - VARIABLES DE ENTORNO (EJEMPLO)
# Copia este archivo a .env y asigna valores seguros para producción.
# ===============================================================================

# Entorno general
PORT=8000
NODE_ENV=development

# Base de Datos PostgreSQL 17
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=valeria
DB_PASSWORD=tu_contrasena_segura_aqui
DB_NAME=bellia

# Seguridad y Autenticación JWT
JWT_SECRET=tu_jwt_secret_seguro_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting y Caché
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
CACHE_TTL=300000

# CORS: Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Almacenamiento de Objetos S3 / MinIO (HU-033)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=tu_minio_root_password_segura
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bellia-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=tu_s3_secret_key_segura
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=http://localhost:9000/bellia-media


# Suscripciones (Stripe en modo de prueba). Las lee docker-compose para el contenedor backend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL de la API vista desde el teléfono (Stripe redirige aquí al terminar el pago)
PUBLIC_API_URL=http://192.168.0.10:8000
