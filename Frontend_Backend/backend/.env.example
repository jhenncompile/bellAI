# Entorno y Servidor
PORT=8000
NODE_ENV=development

# Base de Datos PostgreSQL 17
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_segura
DB_NAME=bellia

# Seguridad y Autenticación JWT
JWT_SECRET=super_secreta_jwt_clave_bellia_2026_segura_enterprise
JWT_EXPIRES_IN=1d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate Limiting y Caché
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
CACHE_TTL=300000

# CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# ========================================================
# [HU-033] ALMACENAMIENTO DE OBJETOS MULTIMEDIA (S3) & CDN
# ========================================================
# Desarrollo local: no declares S3_ACCESS_KEY ni S3_SECRET_KEY. El backend
# guardará los archivos en `uploads/` y los servirá desde su propia API.

# Para AWS S3 en Producción (descomentar y configurar):
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=bellia-production-media
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_FORCE_PATH_STYLE=false

# Configuración de CDN (Amazon CloudFront / Edge Network):
# Producción con CloudFront: https://d111111abcdef8.cloudfront.net o https://cdn.bellia.tech
# Desarrollo Local: http://localhost:8000/uploads
CDN_BASE_URL=http://localhost:8000/uploads

# ========================================================
# Servicio de IA (FastAPI) y cola de tareas
# ========================================================
AI_SERVICE_URL=http://localhost:8001
# Clave compartida opcional; debe coincidir con AI_INTERNAL_KEY del servicio de IA
AI_INTERNAL_KEY=
# Sin REDIS_HOST las tareas se procesan en memoria (solo desarrollo)
REDIS_HOST=localhost
REDIS_PORT=6379
# Asistente conversacional: Kimi (Moonshot) por API. Sin clave se usa Ollama local.
# El proveedor, el modelo y el razonamiento se cambian en el panel (Ajustes → IA).
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Modelo local (Ollama): respaldo sin clave de Kimi o con el proveedor «ollama»
OLLAMA_URL=http://localhost:11434
# Clima (Open-Meteo no requiere clave)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Notificaciones push por Firebase (FCM): ruta a la cuenta de servicio (relativa a backend/, fuera de git)
# o su contenido en FIREBASE_SERVICE_ACCOUNT_JSON (útil en Docker).
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=
# Servicio de Expo (solo para tokens ExponentPushToken). Opcional: si el proyecto exige envíos autenticados.
EXPO_ACCESS_TOKEN=
# true para no enviar ninguna notificación push (p. ej. en pruebas)
PUSH_DISABLED=false

# ========================================================
# SUSCRIPCIONES (plan Gratis / Premium) · Stripe en modo de prueba
# ========================================================
# Claves del sandbox: https://dashboard.stripe.com/test/apikeys (sk_test_...). No mueve dinero real.
STRIPE_SECRET_KEY=
# Local: `stripe listen --forward-to localhost:8000/api/subscriptions/webhook` imprime el whsec_...
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_CENTS=4900
PREMIUM_CURRENCY=bob
PREMIUM_DAYS=30
# URL de esta API vista desde el teléfono (Stripe redirige aquí al terminar el pago)
PUBLIC_API_URL=http://192.168.0.10:8000
