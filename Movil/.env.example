# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE IA Y BACKEND (AURA VISION & WARDROBE)
# ==============================================================================
# Modo de IA:
#   - 'local'  -> Ejecuta la IA de colorimetría y armario en el móvil (Sin servidor)
#   - 'remote' -> Envía las fotos al servidor remoto configurado
#   - 'auto'   -> Intenta el servidor remoto; si no está activo, pasa a IA local
EXPO_PUBLIC_AI_MODE=local

# Servidor Backend (ip:puerto o dominio):
EXPO_PUBLIC_API_URL=ip
